{
	"schemaVersion": 1,
	"id": "mca-tick-usage-patch",
	"version": "${version}",
	"name": "MCA Tick Usage Patch",
	"description": "Configurable navigation baseline and low-overhead pathfinding instrumentation for Minecraft Comes Alive.",
	"authors": [
		"brand"
	],
	"contact": {
		"sources": "https://github.com/brand/mca-tick-usage-patch"
	},
	"license": "CC0-1.0",
	"icon": "assets/mca-tick-usage-patch/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "mca_patch.flood.MCATickUsagePatch",
				"adapter": "kotlin"
			}
		],
		"client": []
	},
	"mixins": [
		"mca-tick-usage-patch.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"suggests": {
		"mca": ">=7.6.3"
	}
